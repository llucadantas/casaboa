---
import { CATEGORIES, NAV_LINKS, SITE_DOMAIN, SITE_EMAIL, SITE_NAME } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-brand">
				<a href="/" class="footer-logo">{SITE_NAME}</a>
				<p class="footer-description">
					Curadoria editorial de produtos, ideias e pequenos rituais para transformar sua
					casa em um lugar mais confortável, organizado e gostoso de viver.
				</p>
				<p class="footer-contact">
					Contato editorial: <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
				</p>
			</div>

			<div class="footer-col">
				<h2 class="footer-heading">Navegação</h2>
				<ul class="footer-links">
					{
						NAV_LINKS.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
					<li><a href="/sobre/#contato">Contato</a></li>
					<li><a href="/privacidade/">Política de Privacidade</a></li>
					<li><a href="/rss.xml">Feed RSS</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h2 class="footer-heading">Categorias</h2>
				<ul class="footer-links footer-links--two-col">
					{
						CATEGORIES.map((cat) => (
							<li>
								<a href={`/categorias/${cat.slug}/`}>{cat.name}</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="footer-copy">
				&copy; {currentYear} {SITE_NAME} ({SITE_DOMAIN}). Todos os direitos reservados.
			</p>
			<p class="footer-disclosure">
				Aviso de transparência: algumas recomendações publicadas podem conter links de
				afiliados, sem custo adicional para você.
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		background-color: var(--color-surface-warm);
		border-top: 1px solid var(--color-border);
		padding-block: 3.5rem 2rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1.2fr;
		gap: 2.5rem 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border-strong);
	}

	.footer-logo {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: 1.55rem;
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
		margin-bottom: 0.75rem;
	}

	.footer-description {
		font-size: 0.92rem;
		color: var(--color-ink-soft);
		max-width: 38ch;
		margin-bottom: 0.85rem;
		line-height: 1.6;
	}

	.footer-contact {
		font-size: 0.88rem;
		color: var(--color-muted);
		margin: 0;
	}

	.footer-contact a {
		color: var(--color-ink);
		font-weight: 500;
	}

	.footer-heading {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: 1rem;
	}

	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.footer-links--two-col {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem 1.25rem;
	}

	.footer-links a {
		font-size: 0.9rem;
		color: var(--color-ink-soft);
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--color-olive-dark);
		text-decoration: underline;
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-top: 1.5rem;
	}

	.footer-copy,
	.footer-disclosure {
		margin: 0;
		font-size: 0.82rem;
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 600px) {
		.site-footer {
			margin-top: 3.5rem;
			padding-block: 2.75rem 1.75rem;
		}

		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
