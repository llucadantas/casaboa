---
import { CATEGORIES } from '../consts';

interface Props {
	activeCategory?: string;
	counts?: Record<string, number>;
	basePath?: string;
}

const { activeCategory, counts = {}, basePath = '/' } = Astro.props;
---

<nav class="category-filter" aria-label="Filtrar artigos por categoria">
	<a
		href={basePath}
		class={`filter-pill ${!activeCategory ? 'is-active' : ''}`}
		aria-current={!activeCategory ? 'page' : undefined}
	>
		Todos
	</a>

	{
		CATEGORIES.map((cat) => {
			const count = counts[cat.name] ?? 0;
			const isActive = activeCategory === cat.slug || activeCategory === cat.name;
			return (
				<a
					href={`/categorias/${cat.slug}/`}
					class={`filter-pill ${isActive ? 'is-active' : ''}`}
					aria-current={isActive ? 'page' : undefined}
				>
					<span>{cat.name}</span>
					{count > 0 && <span class="filter-count">{count}</span>}
				</a>
			);
		})
	}
</nav>

<style>
	.category-filter {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 2rem;
	}

	.filter-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.46rem 0.95rem;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-ink-soft);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		text-decoration: none;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base),
			color var(--transition-base);
	}

	.filter-pill:hover {
		border-color: var(--color-olive);
		color: var(--color-ink);
	}

	.filter-pill.is-active {
		background-color: var(--color-olive);
		border-color: var(--color-olive);
		color: var(--color-surface);
	}

	.filter-count {
		font-size: 0.74rem;
		opacity: 0.8;
	}
</style>
