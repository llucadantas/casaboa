---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	image: ImageMetadata | string;
	imageAlt?: string;
	description: string;
	url: string;
	price?: string;
	highlight?: string;
	category?: string;
	index?: number;
}

const {
	name,
	image,
	imageAlt,
	description,
	url,
	price,
	highlight,
	category,
	index,
} = Astro.props;

const formattedIndex = typeof index === 'number' ? String(index + 1).padStart(2, '0') : undefined;
const resolvedAlt = imageAlt ?? `${name} — recomendação editorial CasaBoa`;
---

<article class="product-card">
	<div class="product-media">
		{
			typeof image === 'string' ? (
				<img src={image} alt={resolvedAlt} loading="lazy" />
			) : (
				<Image src={image} alt={resolvedAlt} width={560} height={420} />
			)
		}
	</div>

	<div class="product-content">
		<div class="product-top">
			<div class="product-tags">
				{formattedIndex && <span class="product-index">{formattedIndex}</span>}
				{category && <span class="product-category">{category}</span>}
				{highlight && <span class="product-highlight">{highlight}</span>}
			</div>
			<h3 class="product-name">{name}</h3>
			<p class="product-description">{description}</p>
		</div>

		<div class="product-actions">
			{price && <span class="product-price">{price}</span>}
			<a
				href={url}
				target="_blank"
				rel="noopener noreferrer nofollow sponsored"
				class="product-cta"
			>
				Ver produto
				<span aria-hidden="true">&#8599;</span>
			</a>
		</div>
	</div>
</article>

<style>
	.product-card {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 1.5rem;
		padding: 1.25rem;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		transition: border-color var(--transition-base);
	}

	.product-card:hover {
		border-color: var(--color-border-strong);
	}

	.product-media {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-sm);
		overflow: hidden;
		background-color: var(--color-surface-warm);
		border: 1px solid var(--color-border);
	}

	.product-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-content {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		min-width: 0;
	}

	.product-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.55rem;
	}

	.product-index {
		font-family: var(--font-serif);
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-olive-dark);
	}

	.product-category {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.product-highlight {
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-olive-tint);
		color: var(--color-olive-dark);
	}

	.product-name {
		font-family: var(--font-serif);
		font-size: 1.2rem;
		line-height: 1.3;
		margin: 0 0 0.45rem;
		color: var(--color-ink);
	}

	.product-description {
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--color-ink-soft);
		margin: 0;
	}

	.product-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border);
	}

	.product-price {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-muted);
	}

	.product-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.5rem 1.05rem;
		background-color: var(--color-bg);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-pill);
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
		margin-left: auto;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base),
			color var(--transition-base);
	}

	.product-cta:hover {
		background-color: var(--color-olive);
		border-color: var(--color-olive);
		color: var(--color-surface);
	}

	@media (max-width: 640px) {
		.product-card {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.product-cta {
			margin-left: 0;
		}
	}
</style>
