---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ProductRecommendation from '../components/ProductRecommendation.astro';
import { DEFAULT_AUTHOR, SITE_NAME, SITE_URL, getCategorySlug } from '../consts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	article: CollectionEntry<'artigos'>;
	relatedArticles?: CollectionEntry<'artigos'>[];
}

const { article, relatedArticles = [] } = Astro.props;
const {
	title,
	description,
	slug,
	category,
	pubDate,
	updatedDate,
	cover,
	coverAlt,
	tags,
	author = DEFAULT_AUTHOR,
	products,
} = article.data;

const canonicalUrl = new URL(`/artigos/${slug}/`, Astro.site ?? SITE_URL).toString();
const imageUrl =
	typeof cover === 'string'
		? new URL(cover, Astro.site ?? SITE_URL).toString()
		: new URL(cover.src, Astro.site ?? SITE_URL).toString();

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	image: [imageUrl],
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Organization',
		name: author,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_NAME,
		url: SITE_URL,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl,
	},
	articleSection: category,
	keywords: tags.join(', '),
};
---

<BaseLayout
	title={`${title} | ${SITE_NAME}`}
	description={description}
	image={cover}
	imageAlt={coverAlt}
	type="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	author={author}
	structuredData={structuredData}
>
	<article class="article-page">
		<header class="article-header">
			<div class="container article-header-inner">
				<nav class="breadcrumb" aria-label="Caminho de navegação">
					<a href="/">Início</a>
					<span aria-hidden="true">/</span>
					<a href={`/categorias/${getCategorySlug(category)}/`}>{category}</a>
				</nav>

				<div class="article-meta-top">
					<CategoryBadge category={category} linked />
					<span class="article-date">
						Publicado em <FormattedDate date={pubDate} />
					</span>
					{
						updatedDate && (
							<span class="article-updated">
								&middot; Atualizado em <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>

				<h1 class="article-title">{title}</h1>
				<p class="article-lead">{description}</p>

				<div class="article-byline">
					<span>Por <strong>{author}</strong></span>
				</div>
			</div>
		</header>

		<div class="container article-cover-wrap">
			<figure class="article-cover">
				{
					typeof cover === 'string' ? (
						<img src={cover} alt={coverAlt} />
					) : (
						<Image
							src={cover}
							alt={coverAlt}
							width={1120}
							height={630}
							loading="eager"
							fetchpriority="high"
						/>
					)
				}
				<figcaption class="cover-caption">{coverAlt}</figcaption>
			</figure>
		</div>

		<div class="container article-body-wrap">
			<div class="prose">
				<slot />
			</div>

			{products && products.length > 0 && <ProductRecommendation products={products} />}

			{
				tags.length > 0 && (
					<footer class="article-tags" aria-label="Assuntos do artigo">
						<span class="tags-label">Assuntos:</span>
						<ul class="tags-list">
							{tags.map((tag) => (
								<li class="tag-pill">{tag}</li>
							))}
						</ul>
					</footer>
				)
			}
		</div>
	</article>

	{
		relatedArticles.length > 0 && (
			<section class="related-section" aria-labelledby="related-heading">
				<div class="container">
					<div class="section-header">
						<div>
							<span class="section-eyebrow">Continue lendo</span>
							<h2 id="related-heading" class="section-title">
								Outros artigos do CasaBoa
							</h2>
						</div>
						<a href="/artigos/" class="related-all-link">
							Ver todos &rarr;
						</a>
					</div>

					<div class="related-grid">
						{relatedArticles.map((related) => (
							<ArticleCard article={related} />
						))}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.article-page {
		padding-top: clamp(1.75rem, 4vw, 3rem);
	}

	.article-header-inner {
		max-width: 820px;
		text-align: left;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.83rem;
		color: var(--color-muted);
		margin-bottom: 1.25rem;
	}

	.breadcrumb a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--color-olive-dark);
		text-decoration: underline;
	}

	.article-meta-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 1rem;
		margin-bottom: 1.15rem;
	}

	.article-date,
	.article-updated {
		font-size: 0.86rem;
		color: var(--color-muted);
	}

	.article-title {
		font-size: clamp(2rem, 3.8vw, 2.95rem);
		line-height: 1.14;
		margin-bottom: 1rem;
	}

	.article-lead {
		font-size: clamp(1.06rem, 1.5vw, 1.2rem);
		line-height: 1.65;
		color: var(--color-ink-soft);
		margin-bottom: 1.15rem;
	}

	.article-byline {
		font-size: 0.88rem;
		color: var(--color-muted);
	}

	.article-byline strong {
		color: var(--color-ink);
		font-weight: 600;
	}

	.article-cover-wrap {
		max-width: 980px;
		margin-top: 2rem;
		margin-bottom: 2.5rem;
	}

	.article-cover {
		margin: 0;
	}

	.article-cover :global(img) {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
	}

	.cover-caption {
		margin-top: 0.65rem;
		font-size: 0.83rem;
		color: var(--color-muted);
		text-align: center;
	}

	.article-body-wrap {
		max-width: var(--prose-max);
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-top: 2.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.tags-label {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--color-muted);
		margin-right: 0.25rem;
	}

	.tags-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tag-pill {
		font-size: 0.8rem;
		padding: 0.3rem 0.75rem;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-ink-soft);
	}

	.related-section {
		margin-top: 4.5rem;
		padding-top: 3.5rem;
		border-top: 1px solid var(--color-border);
	}

	.related-all-link {
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.75rem;
	}

	@media (max-width: 1024px) {
		.related-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
